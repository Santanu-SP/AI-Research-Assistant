APP_NAME=AI Research Assistant API
# The backend defaults to production (secure cookies, no API docs). Local
# development opts out explicitly here.
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
# One JSON object per log line, for log shippers.
LOG_JSON=false
# API docs (/docs) are on outside production unless set to false.
# ENABLE_API_DOCS=
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./backend/data/research_assistant.db
# Neon PostgreSQL configuration (set automatically by `neon init` as DATABASE_URL + DATABASE_URL_UNPOOLED,
# or manually via NEON_DATABASE_URL / NEON_DIRECT_DATABASE_URL).
# DATABASE_URL_UNPOOLED=postgresql+psycopg://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# NEON_DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# NEON_DIRECT_DATABASE_URL=postgresql+psycopg://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# Alternative legacy Supabase configuration (preserved during migration).
# SUPABASE_DB_USER=
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Opt-in: also allow private-network origins (192.168.x.x etc.) in development,
# for testing from a phone. Never enabled in production.
CORS_ALLOW_LOCAL_NETWORK=false
# Unsafe requests (POST/PATCH/DELETE) must carry an allowed Origin or Referer.
REQUIRE_ORIGIN_HEADER=true
# JSON bodies larger than this are refused with 413 before parsing.
MAX_JSON_BODY_BYTES=1048576
# Database connection pool (ignored for SQLite).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
# Document storage: "local" or "r2" (Cloudflare R2 S3-compatible object storage)
STORAGE_BACKEND=local
DOCUMENT_UPLOAD_DIR=backend/data/uploads
DOCUMENT_MAX_UPLOAD_BYTES=26214400
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_REGION=auto
R2_SIGNED_URL_TTL_SECONDS=3600
DOCUMENT_CHUNK_SIZE=4000
DOCUMENT_CHUNK_OVERLAP=400
# Docling is the production parser. Use legacy only for controlled pypdf fallback.
DOCUMENT_INGESTION_BACKEND=docling
INGESTION_VERSION=docling-llamaindex-v1
DOCUMENT_CHUNK_MAX_TOKENS=512
# auto: OCR only when needed; disabled: never OCR; force: OCR every PDF page.
DOCLING_OCR_MODE=auto
AUTH_SESSION_DAYS=7
# Defaults to true in production and false elsewhere. Production refuses false.
AUTH_COOKIE_SECURE=false
# Older sessions beyond this count are revoked at login.
AUTH_MAX_SESSIONS_PER_USER=10
FRONTEND_URL=http://localhost:3000
# Set both values to enable Google OAuth. Never commit real credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_MINUTES=10
# Encryption secret for BYOK (Bring Your Own Key) at rest
API_KEY_ENCRYPTION_SECRET=
# In-process rate limits (per API process). Counts are per IP unless noted.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_HOUR=30
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_QUERY_PER_MINUTE=12
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_OAUTH_START_PER_MINUTE=20
# Only behind a proxy that overwrites X-Forwarded-For (e.g. nginx).
TRUST_FORWARDED_FOR=false
# Background jobs: uploads return 202 and a worker parses and indexes them.
# "inline" processes uploads inside the request (tests, debugging).
INGESTION_MODE=background
WORKER_ENABLED=true
WORKER_THREADS=1
WORKER_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=3
# Jobs running longer than this are treated as crashed and re-queued.
JOB_STALE_AFTER_SECONDS=900
MAINTENANCE_INTERVAL_SECONDS=600
# Queue infrastructure: "database" (Neon background_jobs, ₹0/mo) or "celery" (needs Redis + worker)
QUEUE_BACKEND=database
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_TIME_LIMIT_SECONDS=600
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=540
# Load the embedding and reranker models when the worker starts.
MODEL_WARMUP_ON_STARTUP=false
# Embedding provider: "local" (Qwen/Qwen3-Embedding-0.6B, 1024-d, ₹0) or
# "cloudflare" (@cf/baai/bge-m3, 1024-d, 10,000 Neurons/day free).
# NOTE: Do NOT mix embeddings from different models in the same Neon pgvector corpus.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3
MODEL_TRUST_REMOTE_CODE=false
MODEL_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DIMENSION=1024
VECTOR_TOP_K=24
KEYWORD_TOP_K=24
HYBRID_CANDIDATE_K=24
RRF_K=60
EMBEDDING_ENABLED=true
# Reranker provider: "local" (₹0), "cloudflare" (@cf/baai/bge-reranker-base, 10k Neurons/day free),
# or "jina" (WARNING: Jina 10M starter tokens are one-time & non-commercial CC-BY-NC).
RERANKER_PROVIDER=local
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
RERANKER_MODEL_REVISION=e61197ed45024b0ed8a2d74b80b4d909f1255473
RERANKER_BATCH_SIZE=8
JINA_API_KEY=
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual
CLOUDFLARE_RERANKER_MODEL=@cf/baai/bge-reranker-base
FINAL_CONTEXT_K=8
MINIMUM_EVIDENCE_COUNT=1
RERANKER_MIN_SCORE=0.0
# Multimodal Ingestion (Groq Whisper w/ Gemini audio fallback, keyless Jina Reader, Gemini Vision, FFmpeg)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# r.jina.ai Reader works without an API key (lower rate limit, ₹0 recurring) + BeautifulSoup fallback.
JINA_READER_BASE_URL=https://r.jina.ai
VIDEO_MAX_FRAMES=3
VISION_ENABLED=true
VISION_MIN_IMAGE_DIMENSION=160
# Generation runtime: "ollama" (local) or "router" (cloud failover: Gemini -> OpenRouter -> optional Cerebras/Mistral)
GENERATION_RUNTIME=ollama
GENERATION_MODEL_NAME=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
GENERATION_MAX_NEW_TOKENS=768
GENERATION_TEMPERATURE=0.1
GENERATION_TIMEOUT_SECONDS=120
GENERATION_CONNECT_TIMEOUT_SECONDS=5
GENERATION_MAX_RETRIES=2
GENERATION_RETRY_BACKOFF_SECONDS=0.5
GENERATION_MODEL_CHECK_TTL_SECONDS=300
# Centralized Cloud LLM Router (₹0/month recommended order puts permanent free tiers first)
LLM_ROUTER_PROVIDERS=["gemini","openrouter","cerebras","mistral"]
# Primary (₹0/mo free tier): Gemini 3.8 Flash (+ 3.1 Flash-Lite fallback)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.8-flash
GEMINI_FALLBACK_MODEL_NAME=gemini-3.1-flash-lite
# Secondary fallback (₹0/mo forever, 50 RPD / 20 RPM free): OpenRouter auto free router
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openrouter/free
# Optional temporary credit (one-time $5 promo, requires card, expires in 30 days) — leave empty for ₹0/mo
CEREBRAS_API_KEY=
CEREBRAS_MODEL_NAME=gpt-oss-120b
# Optional paid provider (payment activation required for Mistral Studio API keys) — leave empty for ₹0/mo
MISTRAL_API_KEY=
MISTRAL_MODEL_NAME=mistral-small-4
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
LLM_DAILY_TOKEN_QUOTA_PER_PROVIDER=250000
# Observability (Langfuse disabled by default; telemetry stays in PostgreSQL at ₹0/mo)
TELEMETRY_ENABLED=true
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
