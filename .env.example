APP_NAME=AI Research Assistant API
# The backend defaults to production (secure cookies, no API docs). Local
# development opts out explicitly here.
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
# One JSON object per log line, for log shippers.
LOG_JSON=false
# API docs (/docs) are on outside production unless set to false.
# ENABLE_API_DOCS=
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./backend/data/research_assistant.db
# Alternative Supabase configuration. Set all five values from Dashboard →
# Connect → Session Pooler. The application builds a TLS PostgreSQL URL and
# safely URL-encodes the password. Do not set both these values and DATABASE_URL.
# SUPABASE_DB_USER=
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Opt-in: also allow private-network origins (192.168.x.x etc.) in development,
# for testing from a phone. Never enabled in production.
CORS_ALLOW_LOCAL_NETWORK=false
# Unsafe requests (POST/PATCH/DELETE) must carry an allowed Origin or Referer.
REQUIRE_ORIGIN_HEADER=true
# JSON bodies larger than this are refused with 413 before parsing.
MAX_JSON_BODY_BYTES=1048576
# Database connection pool (ignored for SQLite).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT_SECONDS=10
DOCUMENT_UPLOAD_DIR=backend/data/uploads
DOCUMENT_MAX_UPLOAD_BYTES=26214400
DOCUMENT_CHUNK_SIZE=4000
DOCUMENT_CHUNK_OVERLAP=400
# Docling is the production parser. Use legacy only for controlled pypdf fallback.
DOCUMENT_INGESTION_BACKEND=docling
INGESTION_VERSION=docling-llamaindex-v1
DOCUMENT_CHUNK_MAX_TOKENS=512
# auto: OCR only when needed; disabled: never OCR; force: OCR every PDF page.
DOCLING_OCR_MODE=auto
AUTH_SESSION_DAYS=7
# Defaults to true in production and false elsewhere. Production refuses false.
AUTH_COOKIE_SECURE=false
# Older sessions beyond this count are revoked at login.
AUTH_MAX_SESSIONS_PER_USER=10
FRONTEND_URL=http://localhost:3000
# Set both values to enable Google OAuth. Never commit real credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_MINUTES=10
# In-process rate limits (per API process). Counts are per IP unless noted.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_HOUR=30
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_QUERY_PER_MINUTE=12
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_OAUTH_START_PER_MINUTE=20
# Only behind a proxy that overwrites X-Forwarded-For (see frontend/nginx.conf).
TRUST_FORWARDED_FOR=false
# Background jobs: uploads return 202 and a worker parses and indexes them.
# "inline" processes uploads inside the request (tests, debugging).
INGESTION_MODE=background
WORKER_ENABLED=true
WORKER_THREADS=1
WORKER_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=3
# Jobs running longer than this are treated as crashed and re-queued.
JOB_STALE_AFTER_SECONDS=900
MAINTENANCE_INTERVAL_SECONDS=600
# Load the embedding and reranker models when the worker starts.
MODEL_WARMUP_ON_STARTUP=false
# PR 2 retrieval requires PostgreSQL with pgvector; see docs/development.md.
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
# Hugging Face commits are pinned so a model update cannot change behaviour
# silently. Remote model code is never executed unless explicitly enabled.
EMBEDDING_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
MODEL_TRUST_REMOTE_CODE=false
MODEL_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DIMENSION=1024
VECTOR_TOP_K=24
KEYWORD_TOP_K=24
HYBRID_CANDIDATE_K=24
EMBEDDING_ENABLED=true
# PR 3 reranking keeps the exact local Qwen model in Python.
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
RERANKER_MODEL_REVISION=e61197ed45024b0ed8a2d74b80b4d909f1255473
RERANKER_BATCH_SIZE=8
FINAL_CONTEXT_K=8
MINIMUM_EVIDENCE_COUNT=1
RERANKER_MIN_SCORE=0.0
# Generation runs only through the local Ollama server.
GENERATION_RUNTIME=ollama
GENERATION_MODEL_NAME=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
GENERATION_MAX_NEW_TOKENS=768
GENERATION_TEMPERATURE=0.1
GENERATION_TIMEOUT_SECONDS=120
GENERATION_CONNECT_TIMEOUT_SECONDS=5
# Retries for connection errors and 502/503/504 from Ollama.
GENERATION_MAX_RETRIES=2
GENERATION_MODEL_CHECK_TTL_SECONDS=300
# docker-compose.yml only:
# POSTGRES_PASSWORD=change-me
# PUBLIC_URL=http://localhost:8080
