# Production Environment Template ($0/month Maximum-Quality Cloud Stack)
# Copy secrets ONLY into your hosting dashboard (Northflank/Render/Cloudflare Pages) — never commit real keys.

APP_NAME=AI Research Assistant API
APP_ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1

# --- Neon PostgreSQL + pgvector -------------------------------------------
# Pooled URL for FastAPI runtime requests; direct/unpooled URL for `alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql+psycopg://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# --- Frontend Origin, Cross-Site HTTPS Cookies, & Reverse Proxy -----------
# Required for CORS + CSRF checks and Google OAuth redirect back to Cloudflare Pages.
FRONTEND_URL=https://your-app.pages.dev
CORS_ORIGINS=["https://your-app.pages.dev"]
# Optional regex if you want Cloudflare Pages preview deploys (*.your-app.pages.dev):
# CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?your-app\.pages\.dev$
AUTH_COOKIE_SECURE=true
REQUIRE_ORIGIN_HEADER=true
TRUST_FORWARDED_FOR=true
API_KEY_ENCRYPTION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Direct cross-site: https://your-backend-host/api/v1/auth/google/callback
# Same-origin proxy (recommended for Brave/Safari): https://your-app.pages.dev/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=https://your-backend-host/api/v1/auth/google/callback

# --- Object Storage (Supabase Storage S3 API or Cloudflare R2) ------------
# R2StorageBackend uses standard AWS SigV4 path-style requests and works with both R2 and Supabase S3.
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=research-documents
R2_ENDPOINT_URL=https://PROJECT_REF.supabase.co/storage/v1/s3
R2_REGION=ap-south-1
DOCUMENT_MAX_UPLOAD_BYTES=26214400

# --- Zero-RAM Ingestion + Gemini Flash Scanned-PDF OCR --------------------
DOCUMENT_INGESTION_BACKEND=legacy
INGESTION_VERSION=legacy-gemini-ocr-v1
VISION_ENABLED=true
INGESTION_MODE=background
QUEUE_BACKEND=database
WORKER_ENABLED=true
WORKER_THREADS=1
RESEARCH_WORKER_THREADS=2
MODEL_WARMUP_ON_STARTUP=false

# --- Maximum-Quality $0/month Retrieval & Reranking (Workers AI) ----------
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_PROVIDER=cloudflare
CLOUDFLARE_RERANKER_MODEL=@cf/baai/bge-reranker-base
# Set false for maximum neural reranking quality on EVERY query (including short factual ones & follow-ups).
# Reranker automatically falls back to deterministic lexical scoring if daily Workers AI quota is exhausted.
ADAPTIVE_FAST_PATH_ENABLED=false

# --- Multi-Provider Free Cloud LLM Router + Audio/Video -------------------
GENERATION_RUNTIME=router
LLM_ROUTER_PROVIDERS=["gemini","groq","openrouter"]
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_FALLBACK_MODEL_NAME=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_LLM_MODEL_NAME=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openrouter/free

# --- Frontend Build Variables (set in Cloudflare Pages dashboard) --------
# Direct cross-site: VITE_API_BASE_URL=https://your-backend-host/api/v1
# Same-origin proxy (works in Brave/Safari/Incognito): set both below and update GOOGLE_REDIRECT_URI above:
# VITE_API_BASE_URL=/api/v1
# BACKEND_ORIGIN=https://your-backend-host
